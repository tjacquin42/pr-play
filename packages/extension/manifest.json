{
  "manifest_version": 3,
  "name": "PR Play",
  "version": "0.1.0",
  "description": "Guide de lecture des pull requests : symboles, tests en vis-à-vis, appelants.",
  "host_permissions": ["http://127.0.0.1:7777/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://github.com/*/*/pull/*"],
    "js": ["content.js"],
    "css": ["panel.css"]
  }]
}
